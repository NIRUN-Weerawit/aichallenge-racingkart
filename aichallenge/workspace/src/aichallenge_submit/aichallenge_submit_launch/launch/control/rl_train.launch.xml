<?xml version="1.0" encoding="UTF-8"?>
<!--
  control_method:=rl_train launch entry point.

  This launches the AWSIM reset bridge only. It does NOT start a
  controller that drives the kart. To actually run RL inference,
  launch the SB3 harness in a separate container shell. Example:

    cd /aichallenge/ml_workspace/reinforcement_learning/
    ROS_DOMAIN_ID=1 python3 src/main.py with the infer flag
    pointing at a config YAML

  The bridge is required so that the SB3 harness can call
  /awsim/reset (DOMAIN=1) and have it forwarded to /admin/awsim/reset
  (DOMAIN=0) where AWSIM listens.
-->
<launch>
  <include file="$(find-pkg-share awsim_reset_bridge)/launch/awsim_reset_bridge.launch.xml"/>
</launch>
